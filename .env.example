# Copia este archivo como .env y coloca tus claves.
# No subas .env a GitHub.

# Supabase
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Google Maps
# Web: clave de "Maps JavaScript API", restringida por dominio (HTTP referrer).
# Sin ella, en el navegador se muestra "Mapa no disponible" y la lista sigue funcionando.
EXPO_PUBLIC_GOOGLE_MAPS_WEB_KEY=
# Map ID de Google Cloud para los marcadores avanzados en web (opcional; si falta se usa DEMO_MAP_ID).
EXPO_PUBLIC_GOOGLE_MAPS_MAP_ID=
# Android: clave de "Maps SDK for Android", restringida al paquete y huella SHA-1.
# Solo se necesita en builds propios (no en Expo Go). iOS usa Apple Maps sin clave.
GOOGLE_MAPS_ANDROID_KEY=
